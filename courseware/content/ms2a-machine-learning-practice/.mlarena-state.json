          "icon": "trophy",
          "lessons": [
            "project-brief",
            "project-tracks",
            "project-grading"
          ],
          "summary": "Half the grade. One ML-Arena competition track of your choosing, plus the repository that produced the submission.",
          "title": "Project"
        },
        "mlp-reference": {
          "icon": "book",
          "lessons": [
            "multi-gpu-scaling",
            "cnn-backpropagation",
            "three-d-cnns",
            "image-enhancement",
            "automl-and-custom-objectives",
            "reference-playgrounds"
          ],
          "summary": "Material demoted out of class time. Self-study, linked from the sessions, never lectured.",
          "title": "Reference"
        },
        "s1-data-collection": {
          "icon": "database",
          "lessons": [
            "data-and-its-shapes",
            "files-and-formats",
            "databases",
            "exercise-sql-sandbox",
            "apis",
            "exercise-api-sandbox",
            "web-scraping",
            "collection-strategy-and-quality",
            "lab-1"
          ],
          "summary": "Where data comes from and what it costs to get it: files, databases, APIs, scraping \u2014 and the quality checks that belong at the point of collection rather than three weeks later.",
          "title": "Session 1 \u2014 Data Collection"
        },
        "s10-reinforcement-learning-2": {
          "icon": "cpu",
          "lessons": [
            "from-tables-to-networks",
            "policy-gradients",
            "actor-critic-and-ppo",
            "making-deep-rl-work",
            "multi-agent-rl",
            "lab-10"
          ],
          "summary": "Deep RL: function approximation and DQN, policy gradients, actor-critic and PPO, the practical machinery that makes runs reproducible, and multi-agent environments on ML-Arena.",
          "title": "Session 10 \u2014 Reinforcement Learning 2"
        },
        "s11-docker-and-deployment": {
          "icon": "container",
          "lessons": [
            "why-deploy",
            "docker-concepts",
            "docker-install-and-run",
            "docker-compose-cvat",
            "apis-and-http",
            "serving-a-model-with-fastapi",
            "writing-a-dockerfile",
            "lab-11"
          ],
          "summary": "Take a trained model out of the notebook: save it, serve it behind an HTTP API with FastAPI, and pack the API into a Docker image that runs the same on any machine. Includes a Docker Compose workshop that starts CVAT, a complete image-annotation platform, with one command. Before the session: install Docker Desktop and check that `docker run hello-world` works.",
          "title": "Session 11 \u2014 Docker and Model Deployment"
        },
        "s2-data-preprocessing": {
          "icon": "filter",
          "lessons": [
            "the-preprocessing-contract",
            "duplicates-and-inconsistencies",
            "missing-values",
            "outliers",
            "categorical-encoding",
            "feature-engineering",
            "scaling-and-normalization",
            "feature-selection",
            "lab-2"
          ],
          "summary": "Turning a collected table into a matrix a model can learn from: missing values, duplicates, outliers, encodings, scaling, engineered features \u2014 each one fitted on train and applied to test, never the reverse.",
          "title": "Session 2 \u2014 Data Preprocessing"
        },
        "s3-tabular-models": {
          "icon": "table",
          "lessons": [
            "the-tabular-landscape",
            "knn-and-svm",
            "support-vector-machines",
            "trees-and-ensembles",
            "bagging-and-random-forest",
            "gradient-boosting-in-practice",
            "model-selection-and-validation",
            "stacking-and-blending",
            "hyperparameter-optimization",
            "probabilistic-prediction",
            "saving-and-loading-models",
            "lab-3"
          ],
          "summary": "Tabular ML end to end: fit the models that win (regularised linear, kNN, SVMs, trees, random forests, boosting), validate them without leakage (including time-series), tune them with Optuna and combine them by stacking and blending, and ship the saved pipeline an agent loads to serve them.",
          "title": "Session 3 \u2014 Tabular Models"
        },
        "s4-advanced-neural-networks": {
          "icon": "layers",
          "lessons": [
